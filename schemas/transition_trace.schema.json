{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TR-EIF Transition Trace",
  "description": "Structural JSON schema for deterministic TR-EIF observable trace sequences. Retained balanced-ternary execution state, active neutral state 0, pending targets, energy, forces, and stress remain explicitly separated.",
  "type": "object",
  "required": [
    "format",
    "version",
    "record_count",
    "node_count",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "tr_eif.trace"
    },
    "version": {
      "const": 1
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "node_count": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/trace_record"
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "tensor3x3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/vector3"
      }
    },
    "energy_state": {
      "type": "object",
      "required": [
        "atomic_energies",
        "total_energy"
      ],
      "additionalProperties": false,
      "properties": {
        "atomic_energies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "total_energy": {
          "type": "number"
        }
      }
    },
    "force_state": {
      "type": "object",
      "required": [
        "forces"
      ],
      "additionalProperties": false,
      "properties": {
        "forces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/vector3"
          }
        }
      }
    },
    "stress_state": {
      "type": "object",
      "required": [
        "tensor"
      ],
      "additionalProperties": false,
      "properties": {
        "tensor": {
          "$ref": "#/$defs/tensor3x3"
        }
      }
    },
    "trace_record": {
      "type": "object",
      "required": [
        "step",
        "time",
        "node_count",
        "ternary_execution",
        "energy",
        "forces",
        "stress"
      ],
      "additionalProperties": false,
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "time": {
          "type": "number",
          "minimum": 0
        },
        "node_count": {
          "type": "integer",
          "minimum": 1
        },
        "ternary_execution": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "ternary_state.schema.json"
          },
          "description": "Executed retained -1/0/1 states. State 0 is active neutral and may support balancing, routing, damping, mediation, transition staging, retention, and controlled neutralization. A pending target is distinct from the executed state."
        },
        "energy": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/energy_state"
            }
          ]
        },
        "forces": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/force_state"
            }
          ]
        },
        "stress": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stress_state"
            }
          ]
        }
      }
    }
  },
  "$comment": "The trace schema preserves the executable distinction between retained state, active neutral state 0, and pending target. Missing energy, forces, or stress are serialized as JSON null and are not encoded as ternary 0. Runtime TraceSequence invariants additionally enforce record_count == len(records), common node_count across records, node_count == len(ternary_execution), energy/force cardinality equal to node_count, strictly increasing step values, and nondecreasing time values. Those cross-record and cross-array cardinality invariants remain executable validation responsibilities rather than being approximated by the structural JSON schema."
}
